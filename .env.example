# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini model name; leave blank to use the provider's default
GEMINI_MODEL=
# All file tools are sandboxed to this directory
WORKSPACE_ROOT=./sample_data
# Upper bound on LLM <-> tool round-trips per user query
MAX_TOOL_ITERATIONS=10
